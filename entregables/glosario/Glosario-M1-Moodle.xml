<?xml version="1.0" encoding="UTF-8"?>
<GLOSSARY>
  <INFO>
    <NAME>Glosario del módulo 1</NAME>
    <INTRO></INTRO>
    <INTROFORMAT>1</INTROFORMAT>
    <ENTRIES>
    <ENTRY><CONCEPT>IA generativa</CONCEPT><DEFINITION>&lt;p&gt;tipo de inteligencia artificial que produce contenido nuevo, como texto, imágenes o audio, a partir de una instrucción.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Prompt</CONCEPT><DEFINITION>&lt;p&gt;instrucción, pregunta o texto que se le entrega a un modelo de IA generativa para obtener una respuesta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Modelo de lenguaje</CONCEPT><DEFINITION>&lt;p&gt;modelo de IA generativa que produce y transforma texto.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Modelo de imagen</CONCEPT><DEFINITION>&lt;p&gt;modelo que genera o modifica imágenes a partir de una descripción.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Modelo de audio</CONCEPT><DEFINITION>&lt;p&gt;modelo que genera voz, música o efectos de sonido.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Multimodal</CONCEPT><DEFINITION>&lt;p&gt;herramienta o modelo que recibe o entrega más de un tipo de contenido, por ejemplo imagen y texto.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Token</CONCEPT><DEFINITION>&lt;p&gt;fragmento de texto (palabra, parte de palabra o signo) con el que el modelo lee y escribe.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Contexto</CONCEPT><DEFINITION>&lt;p&gt;información que el modelo tiene a la vista para responder: instrucciones, conversación y archivos entregados.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Ventana de contexto</CONCEPT><DEFINITION>&lt;p&gt;cantidad máxima de tokens que el modelo puede considerar de una vez.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Alucinación</CONCEPT><DEFINITION>&lt;p&gt;información falsa o inventada que el modelo presenta como si fuera verdadera.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Sesgo</CONCEPT><DEFINITION>&lt;p&gt;tendencia a repetir estereotipos o miradas parciales presentes en los datos de entrenamiento.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fecha de corte</CONCEPT><DEFINITION>&lt;p&gt;fecha hasta la cual llega la información con que se entrenó un modelo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Rol</CONCEPT><DEFINITION>&lt;p&gt;perspectiva desde la que se le pide al asistente que responda, por ejemplo «encargado de bodega».&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Contexto (en un prompt)</CONCEPT><DEFINITION>&lt;p&gt;parte del prompt que explica la situación, para quién es la respuesta y para qué se usará.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Tarea</CONCEPT><DEFINITION>&lt;p&gt;lo que se le pide hacer al asistente, expresado con un verbo claro, como resumir o clasificar.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Formato</CONCEPT><DEFINITION>&lt;p&gt;forma, extensión y tono en que se pide la respuesta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Restricción</CONCEPT><DEFINITION>&lt;p&gt;límite que la respuesta debe respetar, como qué información usar o qué no agregar.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Ejemplo en el prompt</CONCEPT><DEFINITION>&lt;p&gt;muestra del resultado esperado que se incluye para orientar el formato o el tono.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Iteración</CONCEPT><DEFINITION>&lt;p&gt;ciclo de pedir, revisar, ajustar y volver a pedir hasta obtener una respuesta útil.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Pregunta de seguimiento</CONCEPT><DEFINITION>&lt;p&gt;mensaje que se envía en la misma conversación para corregir o precisar la respuesta anterior.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Plantilla de prompt</CONCEPT><DEFINITION>&lt;p&gt;prompt reutilizable con las partes variables entre [corchetes].&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Biblioteca de prompts</CONCEPT><DEFINITION>&lt;p&gt;colección ordenada de plantillas probadas, con notas sobre cuándo y cómo usarlas.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Parámetro de generación</CONCEPT><DEFINITION>&lt;p&gt;ajuste que cambia cómo el modelo produce la respuesta sin modificar el prompt.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Temperatura</CONCEPT><DEFINITION>&lt;p&gt;parámetro que regula cuánto azar hay al elegir cada fragmento de la respuesta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Top-p</CONCEPT><DEFINITION>&lt;p&gt;parámetro que limita la elección a las opciones más probables hasta sumar cierta probabilidad.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Tokens máximos de salida</CONCEPT><DEFINITION>&lt;p&gt;tope de tokens que el modelo puede escribir en una respuesta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Valor predeterminado</CONCEPT><DEFINITION>&lt;p&gt;valor que el proveedor asigna a un parámetro cuando la persona no lo cambia o no puede cambiarlo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Regenerar</CONCEPT><DEFINITION>&lt;p&gt;pedir una nueva respuesta al mismo prompt, sin cambiarlo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Instrucción contrastada</CONCEPT><DEFINITION>&lt;p&gt;la misma consigna con dos indicaciones opuestas, una hacia la precisión y otra hacia la creatividad.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Precisión</CONCEPT><DEFINITION>&lt;p&gt;cualidad de una respuesta que se ajusta a los datos y al pedido, sin agregar ni cambiar información.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Google AI Studio</CONCEPT><DEFINITION>&lt;p&gt;entorno de Google para probar modelos e instrucciones y ajustar sus parámetros; exige 18 años o más.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Registro de resultados</CONCEPT><DEFINITION>&lt;p&gt;tabla donde se anotan el prompt, el ajuste, cada salida y su evaluación.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Validación</CONCEPT><DEFINITION>&lt;p&gt;revisión de una respuesta generada, contrastándola con el texto original y con fuentes confiables, antes de usarla.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Confabulación</CONCEPT><DEFINITION>&lt;p&gt;nombre que usa el NIST para la alucinación: contenido falso o erróneo presentado con seguridad.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Desactualización</CONCEPT><DEFINITION>&lt;p&gt;error de una respuesta que da como vigente un dato que ya cambió.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Afirmación verificable</CONCEPT><DEFINITION>&lt;p&gt;dato, cifra, fecha, nombre, cita o referencia que se puede comprobar en una fuente.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fuente confiable</CONCEPT><DEFINITION>&lt;p&gt;fuente con autoría identificable, experiencia en el tema, intereses claros y fecha vigente.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fuente original</CONCEPT><DEFINITION>&lt;p&gt;documento, norma o sitio del que sale un dato, a diferencia de un comentario o resumen sobre él.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Lectura vertical</CONCEPT><DEFINITION>&lt;p&gt;evaluar un sitio leyéndolo de arriba abajo, sin salir de él.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Lectura lateral</CONCEPT><DEFINITION>&lt;p&gt;evaluar un sitio saliendo de él para ver qué dicen otras fuentes sobre quién está detrás.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>SIFT</CONCEPT><DEFINITION>&lt;p&gt;método de cuatro pasos para evaluar información: detenerse, investigar la fuente, buscar mejor cobertura y rastrear hasta el original.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Checklist de validación</CONCEPT><DEFINITION>&lt;p&gt;lista de pasos que se aplica a una respuesta generada antes de usarla o compartirla.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Sesgo de automatización</CONCEPT><DEFINITION>&lt;p&gt;tendencia a confiar de más en lo que entrega una máquina y dejar de revisarlo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Honestidad intelectual</CONCEPT><DEFINITION>&lt;p&gt;actitud de no presentar como propio ni como seguro lo que no lo es.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    </ENTRIES>
  </INFO>
</GLOSSARY>
