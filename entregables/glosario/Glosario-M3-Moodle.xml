<?xml version="1.0" encoding="UTF-8"?>
<GLOSSARY>
  <INFO>
    <NAME>Glosario del módulo 3</NAME>
    <INTRO></INTRO>
    <INTROFORMAT>1</INTROFORMAT>
    <ENTRIES>
    <ENTRY><CONCEPT>Pregunta de investigación</CONCEPT><DEFINITION>&lt;p&gt;pregunta específica sobre un tema acotado que se puede responder buscando información.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Tema acotado</CONCEPT><DEFINITION>&lt;p&gt;tema general al que se le agregaron criterios, como lugar, período o tipo de organización.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Concepto clave</CONCEPT><DEFINITION>&lt;p&gt;palabra o expresión central de una pregunta, que se usa para buscar.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Necesidad de información</CONCEPT><DEFINITION>&lt;p&gt;lo que una persona define antes de buscar: cuánta información, de qué tipo, de qué período y con qué profundidad.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Buscador con citas</CONCEPT><DEFINITION>&lt;p&gt;herramienta que busca en internet al momento, resume lo encontrado y enlaza cada afirmación a su página de origen.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Cita (en una respuesta de IA)</CONCEPT><DEFINITION>&lt;p&gt;número o enlace que indica de qué fuente salió una afirmación.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Pregunta de seguimiento</CONCEPT><DEFINITION>&lt;p&gt;pregunta que continúa una búsqueda anterior y conserva su contexto.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Asistente sobre fuentes propias</CONCEPT><DEFINITION>&lt;p&gt;herramienta que responde a partir de los documentos que la persona le entrega.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Cuaderno</CONCEPT><DEFINITION>&lt;p&gt;espacio de Gemini Notebook donde se reúnen las fuentes de un tema para hacerles preguntas.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Investigación a fondo</CONCEPT><DEFINITION>&lt;p&gt;modo de algunos asistentes que revisa muchas páginas y entrega un informe largo con fuentes.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Registro de fuentes</CONCEPT><DEFINITION>&lt;p&gt;tabla donde se anota cada fuente con título, autor, fecha, enlace y lo que aporta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fuente de un dato</CONCEPT><DEFINITION>&lt;p&gt;página o documento de donde sale una información, distinto de la herramienta con que se encontró.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Confiabilidad</CONCEPT><DEFINITION>&lt;p&gt;grado en que se puede confiar en una fuente según su autoría, su fecha, su respaldo y su propósito.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Test CRAAP</CONCEPT><DEFINITION>&lt;p&gt;lista de preguntas para evaluar información con cinco criterios: actualidad, relevancia, autoridad, exactitud y propósito.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Autoría</CONCEPT><DEFINITION>&lt;p&gt;quién escribe o publica una fuente, con qué credenciales y desde qué institución.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Actualidad</CONCEPT><DEFINITION>&lt;p&gt;criterio que revisa cuándo se publicó o revisó una fuente y si esa fecha sirve para la pregunta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Respaldo</CONCEPT><DEFINITION>&lt;p&gt;origen verificable de un dato, como un estudio, una norma o un registro. En CRAAP se llama exactitud.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Propósito</CONCEPT><DEFINITION>&lt;p&gt;intención de una fuente: informar, enseñar, vender, entretener o persuadir.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fuente primaria</CONCEPT><DEFINITION>&lt;p&gt;fuente que produce el dato, como el texto de una ley o el informe de una encuesta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Triangulación</CONCEPT><DEFINITION>&lt;p&gt;uso de varias fuentes, métodos o personas sobre un mismo tema para compensar las debilidades de cada uno.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fuentes independientes</CONCEPT><DEFINITION>&lt;p&gt;fuentes que llegaron a un dato por caminos distintos, sin copiarse entre sí.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Corroborar</CONCEPT><DEFINITION>&lt;p&gt;confirmar un hallazgo porque otras fuentes independientes llegan a lo mismo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Contradicción entre fuentes</CONCEPT><DEFINITION>&lt;p&gt;situación en que dos fuentes afirman cosas incompatibles sobre lo mismo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Matriz de contraste</CONCEPT><DEFINITION>&lt;p&gt;tabla que cruza afirmaciones y fuentes para ver cuáles confirman, contradicen o no dicen nada.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Síntesis</CONCEPT><DEFINITION>&lt;p&gt;texto que une las ideas de varias fuentes, organizado por temas, con conclusiones propias.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Respeto por la autoría</CONCEPT><DEFINITION>&lt;p&gt;reconocer de quién es cada idea y mantener su contexto e intención.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Informe breve</CONCEPT><DEFINITION>&lt;p&gt;documento de hasta unas dos páginas que presenta hallazgos y recomendaciones sobre un solo tema a quien debe decidir.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Mensajes clave</CONCEPT><DEFINITION>&lt;p&gt;viñetas al inicio de un informe con lo esencial que debe llevarse quien lo lee.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Hallazgo</CONCEPT><DEFINITION>&lt;p&gt;resultado de una investigación, respaldado por una o más fuentes.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Limitación</CONCEPT><DEFINITION>&lt;p&gt;aspecto que reduce el alcance de un hallazgo, como pocas fuentes o datos de otro contexto.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Recomendación</CONCEPT><DEFINITION>&lt;p&gt;acción concreta, creíble y viable que se desprende de los hallazgos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Citar</CONCEPT><DEFINITION>&lt;p&gt;indicar de dónde sale cada idea o dato que se usa en un texto.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>APA 7</CONCEPT><DEFINITION>&lt;p&gt;séptima edición de la norma de citación de la Asociación Estadounidense de Psicología (American Psychological Association).&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Cita en el texto</CONCEPT><DEFINITION>&lt;p&gt;indicación breve, con autor y año, junto a la idea que se toma de una fuente.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Lista de referencias</CONCEPT><DEFINITION>&lt;p&gt;lista al final de un texto con los datos completos de cada fuente citada.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>s.f.</CONCEPT><DEFINITION>&lt;p&gt;abreviatura de «sin fecha», que se usa en la referencia cuando la fuente no indica su fecha.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fecha de recuperación</CONCEPT><DEFINITION>&lt;p&gt;fecha en que se consultó una página cuyo contenido puede cambiar.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fecha de promulgación</CONCEPT><DEFINITION>&lt;p&gt;fecha en que se aprueba formalmente una ley; es la que se usa al citarla en APA.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Visualización de datos</CONCEPT><DEFINITION>&lt;p&gt;representación de datos en un gráfico o una tabla para facilitar su comprensión.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Evaluación crítica</CONCEPT><DEFINITION>&lt;p&gt;revisión de un resultado de IA que considera sus sesgos, su trazabilidad y sus límites.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Trazabilidad</CONCEPT><DEFINITION>&lt;p&gt;posibilidad de seguir una afirmación hasta la fuente de donde salió.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Dato personal</CONCEPT><DEFINITION>&lt;p&gt;información que identifica o permite identificar, directa o indirectamente, a una persona natural.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Dato sensible</CONCEPT><DEFINITION>&lt;p&gt;dato personal sobre aspectos como la salud, el origen étnico, las creencias, la afiliación sindical o la vida sexual, que la ley protege con más fuerza.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Persona natural</CONCEPT><DEFINITION>&lt;p&gt;ser humano, a diferencia de una persona jurídica como una empresa.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Titular de datos</CONCEPT><DEFINITION>&lt;p&gt;persona a quien se refieren los datos personales.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Consentimiento</CONCEPT><DEFINITION>&lt;p&gt;autorización expresa e informada que da el titular para que se usen sus datos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Deber de secreto</CONCEPT><DEFINITION>&lt;p&gt;obligación de guardar reserva sobre los datos personales que se conocen por el trabajo, incluso después de dejar esa función.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Información confidencial</CONCEPT><DEFINITION>&lt;p&gt;información a la que solo pueden acceder personas concretas, como remuneraciones o contratos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Información interna</CONCEPT><DEFINITION>&lt;p&gt;información a la que solo accede el personal de una organización.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Política interna</CONCEPT><DEFINITION>&lt;p&gt;reglas propias de una organización sobre qué herramientas se usan y qué información puede salir.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Anonimizar</CONCEPT><DEFINITION>&lt;p&gt;quitar o cambiar los datos de modo que ya no se pueda saber a quién se refieren.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Reidentificación</CONCEPT><DEFINITION>&lt;p&gt;volver a saber a quién se refiere un dato anonimizado, combinándolo con otra información.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    </ENTRIES>
  </INFO>
</GLOSSARY>
