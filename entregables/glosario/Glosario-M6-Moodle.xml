<?xml version="1.0" encoding="UTF-8"?>
<GLOSSARY>
  <INFO>
    <NAME>Glosario del módulo 6</NAME>
    <INTRO></INTRO>
    <INTROFORMAT>1</INTROFORMAT>
    <ENTRIES>
    <ENTRY><CONCEPT>Diagnóstico</CONCEPT><DEFINITION>&lt;p&gt;descripción de cómo se hace hoy una tarea, cuánto cuesta y qué sale mal, apoyada en datos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Situación inicial</CONCEPT><DEFINITION>&lt;p&gt;estado de la tarea antes de cualquier cambio, descrito con el diagnóstico y la línea base.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Línea base</CONCEPT><DEFINITION>&lt;p&gt;valor de un indicador en el punto de partida, que sirve de referencia para comparar después.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Indicador</CONCEPT><DEFINITION>&lt;p&gt;medida que muestra si se avanza hacia una meta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fórmula del indicador</CONCEPT><DEFINITION>&lt;p&gt;forma de calcular el indicador a partir de los datos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fuente del indicador</CONCEPT><DEFINITION>&lt;p&gt;lugar de donde sale el dato, como un registro o una planilla.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Frecuencia de medición</CONCEPT><DEFINITION>&lt;p&gt;cada cuánto se calcula el indicador.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Indicador de proceso</CONCEPT><DEFINITION>&lt;p&gt;indicador que mide cómo se hace la tarea, por ejemplo el tiempo que toma.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Indicador de resultado</CONCEPT><DEFINITION>&lt;p&gt;indicador que mide el efecto buscado, por ejemplo la baja de los reclamos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Meta</CONCEPT><DEFINITION>&lt;p&gt;cambio esperado en un indicador, con un valor y un plazo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Meta SMART</CONCEPT><DEFINITION>&lt;p&gt;meta específica, medible, alcanzable, realista y con plazo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Viabilidad</CONCEPT><DEFINITION>&lt;p&gt;condición de un proyecto que se puede llevar a cabo y medir con los datos, recursos y permisos disponibles.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Plan de medición</CONCEPT><DEFINITION>&lt;p&gt;tabla que define, para cada indicador, fórmula, fuente, frecuencia, línea base y meta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Implementación</CONCEPT><DEFINITION>&lt;p&gt;puesta en marcha de un cambio en una tarea real, con pruebas y ajustes.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Ciclo PDSA</CONCEPT><DEFINITION>&lt;p&gt;ciclo de mejora de cuatro momentos: planificar, hacer, estudiar y actuar.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Prueba a pequeña escala</CONCEPT><DEFINITION>&lt;p&gt;ensayo de un cambio con pocos casos antes de adoptarlo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Punto de control</CONCEPT><DEFINITION>&lt;p&gt;momento del flujo en que una persona revisa el resultado con un criterio definido.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Sesgo de automatización</CONCEPT><DEFINITION>&lt;p&gt;tendencia a confiar de más en lo que produce un sistema automatizado.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Gestión de cambios</CONCEPT><DEFINITION>&lt;p&gt;forma de controlar las modificaciones a un flujo, probando de nuevo cada cambio.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Plan de contingencia</CONCEPT><DEFINITION>&lt;p&gt;lo que se hace si un flujo deja de funcionar y cómo se detecta la falla.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Ficha del flujo</CONCEPT><DEFINITION>&lt;p&gt;documento que describe propósito, entradas, salidas, dependencias, supervisión y contingencia de un flujo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Dependencia</CONCEPT><DEFINITION>&lt;p&gt;herramienta, cuenta o archivo sin el cual el flujo no funciona.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Convención de nombres</CONCEPT><DEFINITION>&lt;p&gt;regla fija para nombrar flujos, plantillas y archivos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Bitácora de decisiones</CONCEPT><DEFINITION>&lt;p&gt;registro fechado de cada decisión del proyecto, con su contexto y sus consecuencias.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Versión de un prompt</CONCEPT><DEFINITION>&lt;p&gt;cada estado guardado y fechado de una plantilla, probado con los mismos casos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Historial de versiones</CONCEPT><DEFINITION>&lt;p&gt;función de un documento o planilla que guarda sus cambios y permite volver a una versión anterior.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Caso de prueba (de un flujo)</CONCEPT><DEFINITION>&lt;p&gt;ejemplo preparado para comprobar si el flujo funciona, incluidos casos difíciles.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Valor final</CONCEPT><DEFINITION>&lt;p&gt;resultado de un indicador al terminar el periodo de medición.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Comparación antes y después</CONCEPT><DEFINITION>&lt;p&gt;contraste entre la línea base y el valor final de un indicador.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Factor externo</CONCEPT><DEFINITION>&lt;p&gt;cambio ajeno al proyecto que pudo influir en los resultados.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Grupo de comparación</CONCEPT><DEFINITION>&lt;p&gt;casos parecidos que no pasaron por el cambio y sirven para contrastar resultados.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Estimación</CONCEPT><DEFINITION>&lt;p&gt;valor aproximado que se comunica reconociendo su incertidumbre.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Propuesta de mejora</CONCEPT><DEFINITION>&lt;p&gt;cambio concreto para el siguiente ciclo, con su motivo y su forma de medirlo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Autocrítica constructiva</CONCEPT><DEFINITION>&lt;p&gt;revisión honesta del propio trabajo para mejorarlo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Relato con datos</CONCEPT><DEFINITION>&lt;p&gt;forma de comunicar resultados que combina cifras, contexto y una o dos ideas clave.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Pitch</CONCEPT><DEFINITION>&lt;p&gt;presentación breve que busca captar la atención y comunicar una propuesta de forma directa.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Apertura</CONCEPT><DEFINITION>&lt;p&gt;inicio del pitch que capta la atención con una historia breve, un dato o una pregunta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Llamado a la acción</CONCEPT><DEFINITION>&lt;p&gt;cierre del pitch que dice qué se pide o propone a la audiencia.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Prueba de las dos frases</CONCEPT><DEFINITION>&lt;p&gt;resumir el pitch en dos frases y pedir a otra persona que lo explique de vuelta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Portafolio profesional</CONCEPT><DEFINITION>&lt;p&gt;selección intencionada de evidencias de logros, esfuerzo y crecimiento, adaptada a una audiencia.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Demo Day</CONCEPT><DEFINITION>&lt;p&gt;presentación de cierre del curso, para la que el pitch y el portafolio son el insumo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    </ENTRIES>
  </INFO>
</GLOSSARY>
