<?xml version="1.0" encoding="UTF-8"?>
<GLOSSARY>
  <INFO>
    <NAME>Glosario del módulo 5</NAME>
    <INTRO></INTRO>
    <INTROFORMAT>1</INTROFORMAT>
    <ENTRIES>
    <ENTRY><CONCEPT>Automatización</CONCEPT><DEFINITION>&lt;p&gt;hacer que una tarea se realice sola, con una herramienta que sigue pasos definidos cada vez que hace falta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Tarea rutinaria</CONCEPT><DEFINITION>&lt;p&gt;tarea que se repite y sigue pasos claros que se pueden escribir como reglas.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Tarea no rutinaria</CONCEPT><DEFINITION>&lt;p&gt;tarea que exige resolver problemas, criterio en cada caso o trato con personas.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Exposición a la IA</CONCEPT><DEFINITION>&lt;p&gt;grado en que la IA generativa podría hacer o ayudar a hacer una tarea; no equivale a reemplazo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Aumento del trabajo</CONCEPT><DEFINITION>&lt;p&gt;efecto de la tecnología que automatiza algunas tareas y deja tiempo para otras, sin eliminar el cargo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Mapa de tareas</CONCEPT><DEFINITION>&lt;p&gt;lista de las tareas concretas de un cargo, escritas con un verbo y un objeto.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Impacto</CONCEPT><DEFINITION>&lt;p&gt;cuánto mejora el trabajo si una tarea se automatiza, por su frecuencia, el tiempo ganado y el beneficio para las personas.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Riesgo</CONCEPT><DEFINITION>&lt;p&gt;lo que puede salir mal si una tarea se hace sola, según los datos que usa, el efecto de un error y la dificultad de detectarlo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Matriz de priorización</CONCEPT><DEFINITION>&lt;p&gt;cuadrícula de 2 × 2 que cruza dos criterios para decidir qué hacer primero.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Victoria rápida</CONCEPT><DEFINITION>&lt;p&gt;opción de mucho impacto y poco esfuerzo en la matriz clásica de impacto y esfuerzo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Fundamento</CONCEPT><DEFINITION>&lt;p&gt;explicación de por qué una tarea quedó en un cuadrante, con los criterios y los datos que lo respaldan.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Flujo automatizado</CONCEPT><DEFINITION>&lt;p&gt;cadena de pasos que se ejecuta sola cuando ocurre un evento o llega una hora definida.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>No-code</CONCEPT><DEFINITION>&lt;p&gt;forma de crear flujos o aplicaciones eligiendo bloques ya hechos, sin escribir código.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Disparador</CONCEPT><DEFINITION>&lt;p&gt;evento que inicia un flujo, como la llegada de un correo o una hora programada.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Acción</CONCEPT><DEFINITION>&lt;p&gt;lo que hace el flujo después del disparador, como resumir un texto o agregar una fila.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Condición</CONCEPT><DEFINITION>&lt;p&gt;regla que decide si el flujo sigue o qué camino toma, según un dato de un paso anterior.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Filtro (en un flujo)</CONCEPT><DEFINITION>&lt;p&gt;condición que deja seguir el flujo solo si se cumple una regla.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Mapear un campo</CONCEPT><DEFINITION>&lt;p&gt;conectar un dato que sale de un paso con un campo de un paso posterior.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Conector</CONCEPT><DEFINITION>&lt;p&gt;componente que une una plataforma con un servicio, como Gmail o Google Sheets, y ofrece sus disparadores y acciones.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Datos de prueba</CONCEPT><DEFINITION>&lt;p&gt;datos ficticios o de ejemplo que se usan para armar y probar un flujo sin arriesgar información real.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Plan de pruebas</CONCEPT><DEFINITION>&lt;p&gt;lista de casos con su resultado esperado, para comprobar si un flujo funciona.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Historial de ejecuciones</CONCEPT><DEFINITION>&lt;p&gt;registro de cada vez que corrió un flujo, con los pasos que funcionaron y los que fallaron.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Escenario</CONCEPT><DEFINITION>&lt;p&gt;nombre que Make da a un flujo; sus pasos se llaman módulos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Crédito</CONCEPT><DEFINITION>&lt;p&gt;unidad con que Make cuenta el uso del plan; cada acción de un módulo suele gastar uno.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Acción programada</CONCEPT><DEFINITION>&lt;p&gt;pedido a Gemini que se ejecuta solo, en un día y hora definidos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Error en cadena</CONCEPT><DEFINITION>&lt;p&gt;error que nace en un paso de un flujo y se repite en los siguientes y en cada ejecución.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Confabulación</CONCEPT><DEFINITION>&lt;p&gt;contenido falso que la IA generativa entrega con tono seguro; también se le llama alucinación.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Sesgo de automatización</CONCEPT><DEFINITION>&lt;p&gt;tendencia a confiar de más en lo que entrega un sistema automático.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Supervisión humana</CONCEPT><DEFINITION>&lt;p&gt;intervención de personas para revisar, corregir o detener lo que hace un sistema de IA.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Participación humana (*human-in-the-loop*)</CONCEPT><DEFINITION>&lt;p&gt;supervisión en que una persona interviene en cada decisión del sistema.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Control humano (*human-on-the-loop*)</CONCEPT><DEFINITION>&lt;p&gt;supervisión en que una persona diseña el sistema y sigue su funcionamiento, sin revisar cada caso.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Mando humano (*human-in-command*)</CONCEPT><DEFINITION>&lt;p&gt;supervisión global en que una persona decide cuándo y cómo usar el sistema, o no usarlo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Punto de control</CONCEPT><DEFINITION>&lt;p&gt;lugar de un flujo donde una persona revisa el resultado antes de que siga.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Criterio de aprobación</CONCEPT><DEFINITION>&lt;p&gt;pregunta de sí o no que la persona revisora usa para aprobar o rechazar un resultado.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Trazabilidad (de un flujo)</CONCEPT><DEFINITION>&lt;p&gt;posibilidad de reconstruir qué datos, pasos y decisiones llevaron a un resultado.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Reversibilidad</CONCEPT><DEFINITION>&lt;p&gt;posibilidad de detener un flujo y deshacer o corregir sus efectos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Plan de contingencia</CONCEPT><DEFINITION>&lt;p&gt;acuerdo previo sobre qué hacer si un flujo falla o se equivoca.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Decisión automatizada</CONCEPT><DEFINITION>&lt;p&gt;decisión basada en el tratamiento automatizado de datos, sin intervención de una persona.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Rendición de cuentas</CONCEPT><DEFINITION>&lt;p&gt;obligación de responder por el funcionamiento y los resultados de un sistema que se puso en marcha.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    </ENTRIES>
  </INFO>
</GLOSSARY>
