<?xml version="1.0" encoding="UTF-8"?>
<GLOSSARY>
  <INFO>
    <NAME>Glosario del módulo 4</NAME>
    <INTRO></INTRO>
    <INTROFORMAT>1</INTROFORMAT>
    <ENTRIES>
    <ENTRY><CONCEPT>Licencia</CONCEPT><DEFINITION>&lt;p&gt;permiso que da quien tiene los derechos de una obra para usarla con ciertas condiciones.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Creative Commons (CC)</CONCEPT><DEFINITION>&lt;p&gt;conjunto de licencias estándar para compartir obras indicando qué usos se permiten.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>CC0</CONCEPT><DEFINITION>&lt;p&gt;herramienta para dedicar una obra al dominio público, sin condiciones de uso.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Términos de uso</CONCEPT><DEFINITION>&lt;p&gt;condiciones que fija una herramienta para usarla y para usar lo que genera.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Uso comercial</CONCEPT><DEFINITION>&lt;p&gt;uso de una obra o pieza con fines de lucro o para obtener una ventaja comercial.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Obra derivada</CONCEPT><DEFINITION>&lt;p&gt;obra nueva hecha a partir de otra, por ejemplo al modificarla o adaptarla.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Derecho de autor</CONCEPT><DEFINITION>&lt;p&gt;conjunto de derechos que la ley reconoce a quien crea una obra; incluye derechos patrimoniales y morales.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Derecho moral</CONCEPT><DEFINITION>&lt;p&gt;parte del derecho de autor que protege la autoría y la integridad de la obra.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Atribución</CONCEPT><DEFINITION>&lt;p&gt;reconocimiento de quién creó una obra que se usa.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>TASL</CONCEPT><DEFINITION>&lt;p&gt;fórmula para atribuir: título, autor, fuente y licencia.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Ultrafalso</CONCEPT><DEFINITION>&lt;p&gt;imagen, audio o video sintético que hace pasar por real algo que no ocurrió.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Ficha de uso ético</CONCEPT><DEFINITION>&lt;p&gt;registro que acompaña una pieza y documenta herramientas, instrucciones, aporte humano, permisos y créditos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Campaña interna</CONCEPT><DEFINITION>&lt;p&gt;comunicación dirigida a las personas de una organización para informar o promover una conducta.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Prompt visual</CONCEPT><DEFINITION>&lt;p&gt;instrucción que describe la imagen que se quiere generar: sujeto, contexto y estilo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Modificador</CONCEPT><DEFINITION>&lt;p&gt;palabra o frase del prompt que controla un aspecto de la imagen, como el encuadre o la luz.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Encuadre</CONCEPT><DEFINITION>&lt;p&gt;qué parte de la escena se ve y qué tan cerca está el sujeto.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Relación de aspecto</CONCEPT><DEFINITION>&lt;p&gt;proporción entre el ancho y el alto de una imagen, como 3:4 o 16:9.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Iterar</CONCEPT><DEFINITION>&lt;p&gt;mejorar un resultado en versiones sucesivas, cambiando un detalle en cada una.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Jerarquía visual</CONCEPT><DEFINITION>&lt;p&gt;orden en que la vista recorre los elementos de una pieza según su importancia.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Contraste</CONCEPT><DEFINITION>&lt;p&gt;diferencia de claridad o intensidad entre un elemento y su fondo.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Texto alternativo</CONCEPT><DEFINITION>&lt;p&gt;descripción en texto de una imagen, que cumple su función para quien no puede verla.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Sesgo visual</CONCEPT><DEFINITION>&lt;p&gt;tendencia de un generador de imágenes a repetir estereotipos o a subrepresentar a ciertos grupos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>SynthID</CONCEPT><DEFINITION>&lt;p&gt;marca de agua invisible que Google incrusta en el contenido que crean sus modelos.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Credenciales de contenido (C2PA)</CONCEPT><DEFINITION>&lt;p&gt;estándar abierto que registra el origen y las ediciones de un archivo digital.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Metadatos</CONCEPT><DEFINITION>&lt;p&gt;datos que acompañan a un archivo y describen, por ejemplo, cómo y con qué se creó.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Locución</CONCEPT><DEFINITION>&lt;p&gt;texto leído en voz alta que acompaña una pieza de audio o video.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Texto a voz</CONCEPT><DEFINITION>&lt;p&gt;función que convierte un texto escrito en voz sintética.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Voz sintética</CONCEPT><DEFINITION>&lt;p&gt;voz generada por una herramienta, no grabada por una persona.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Diseño de voz</CONCEPT><DEFINITION>&lt;p&gt;creación de una voz sintética nueva, que no copia la de una persona real.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Clonación de voz</CONCEPT><DEFINITION>&lt;p&gt;copia de la voz de una persona real a partir de grabaciones suyas.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Réplica digital</CONCEPT><DEFINITION>&lt;p&gt;audio, imagen o video que imita de forma realista la voz o la apariencia de una persona.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Música generativa</CONCEPT><DEFINITION>&lt;p&gt;música creada por una herramienta de IA a partir de una descripción.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Pista</CONCEPT><DEFINITION>&lt;p&gt;archivo de música o sonido que se usa en una pieza.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Derecho a la propia imagen</CONCEPT><DEFINITION>&lt;p&gt;derecho de una persona a decidir sobre el uso de su imagen.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Dato biométrico</CONCEPT><DEFINITION>&lt;p&gt;dato que permite identificar a una persona, como sus rasgos faciales o su voz.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Dato personal sensible</CONCEPT><DEFINITION>&lt;p&gt;dato que la ley protege de forma especial y que solo se trata con consentimiento expreso, salvo excepciones.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Consentimiento expreso</CONCEPT><DEFINITION>&lt;p&gt;permiso libre, específico, inequívoco e informado que la persona da de forma clara, por escrito, de palabra o por un medio tecnológico equivalente.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Clip</CONCEPT><DEFINITION>&lt;p&gt;video breve, de pocos segundos o minutos, con un solo mensaje.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Guion (de un video)</CONCEPT><DEFINITION>&lt;p&gt;texto que organiza lo que se dirá y se mostrará en un video.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Secuencia</CONCEPT><DEFINITION>&lt;p&gt;tramo del guion con un texto, una imagen, un plano, un sonido y una duración.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Plano</CONCEPT><DEFINITION>&lt;p&gt;qué tan cerca o lejos se muestra el sujeto en una imagen o toma.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Toma</CONCEPT><DEFINITION>&lt;p&gt;fragmento continuo de video, grabado o generado.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Llamado a la acción</CONCEPT><DEFINITION>&lt;p&gt;parte del guion que dice qué tiene que hacer la persona después de ver la pieza.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Preproducción</CONCEPT><DEFINITION>&lt;p&gt;etapa de planificación: tema, guion, recursos y verificación de licencias.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Producción</CONCEPT><DEFINITION>&lt;p&gt;etapa en que se graban o generan los recursos del video.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Postproducción</CONCEPT><DEFINITION>&lt;p&gt;etapa de edición y publicación del video.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Montaje</CONCEPT><DEFINITION>&lt;p&gt;ordenar y unir tomas, imágenes, voz y música para formar el video.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Línea de tiempo</CONCEPT><DEFINITION>&lt;p&gt;espacio del editor donde se ordenan los recursos según el momento en que aparecen.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Video generativo</CONCEPT><DEFINITION>&lt;p&gt;video sintético creado por una herramienta de IA a partir de un texto o una imagen.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Exportar</CONCEPT><DEFINITION>&lt;p&gt;generar el archivo final de video a partir del proyecto de montaje.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    <ENTRY><CONCEPT>Subtítulos</CONCEPT><DEFINITION>&lt;p&gt;texto en pantalla que reproduce lo que se dice en el audio.&lt;/p&gt;</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
    </ENTRIES>
  </INFO>
</GLOSSARY>
